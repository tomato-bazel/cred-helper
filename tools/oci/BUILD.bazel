"""Target platform for the linux/amd64 cross-compile. Pass via
`bazel build ... --platforms=//tools/oci:linux_amd64` to make the rust_binary
build as x86-64 Linux (the CI image arch) via zig cc, even on a mac.
"""

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# linux/arm64 — Graviton CI runners and arm64 dev machines. The zig
# linux_arm64_gnu.2.28 toolchain and the aarch64-unknown-linux-gnu rustlib are
# ALREADY registered in MODULE.bazel; only this platform was missing, which is
# why no arm64 artifact was ever published.
platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)
